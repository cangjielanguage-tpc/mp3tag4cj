main() {
    var buffer: Array<Int8> = loadFile("../../../../test/LLT/framedata/testfiles/v1andv23andcustomtags.mp3")
    var tag_23: Option<AbstractID3v2Tag> = ID3v2TagFactory.createTag(buffer)
    var tag = tag_23.getOrThrow()
    var Comment = tag.getComment()
    println("Comment ==> ${Comment}")
    if (Comment != "COMMENT123456789012345678901") {
        return 1
    }
    tag.setComment("中文comment")
    Comment = tag.getComment()
    println("Comment ==> ${Comment}")
    if (Comment != "中文comment") {
        return 1
    }
    var bytes = tag.toBytes()
    println("bytes ==>${bytes}")
    if (bytes != [73, 68, 51, 3, 0, 0, 0, 0, 3, 31, 67, 79, 77, 77, 0, 0, 0, 26, 0, 0, 2, 101, 110, 103, 0, 0, -2, -1, 78,
