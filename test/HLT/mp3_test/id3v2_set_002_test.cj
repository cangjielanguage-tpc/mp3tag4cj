// ID3v2FrameSet类验证
@Test
public class ID3V2SetTestB {
    // 纯接口测试:标签帧标识的设置和获取
    @TestCase
    func id3v2_set_test_04(): Unit {
        var id: String

        id = "id"
        var frameSet: ID3v2FrameSet = ID3v2FrameSet(id)
        @Assert(frameSet.getId(), id)

        id = ""
        frameSet = ID3v2FrameSet(id)
        @Assert(frameSet.getId(), id)

        id = "##--++***"
        frameSet = ID3v2FrameSet(id)
        @Assert(frameSet.getId(), id)
    }

