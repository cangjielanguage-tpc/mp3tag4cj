// ID3v2Frame类验证
@Test
public class ID3V2TestB {
    var basePath: String = getcwd()

    // 接口测试:init (id: String, data: Array<Int8>)
    @TestCase
    func id3v2_test_02(): Unit {
        var id: String

        id = "id"
        var frame: ID3v2Frame = ID3v2Frame(id, getArray(1))
        @Assert(frame.getId(), id)

        id = ""
        frame = ID3v2Frame(id, getArray(1))
        @Assert(frame.getId(), id)

        id = "##--++***"
        frame = ID3v2Frame(id, getArray(1))
        @Assert(frame.getId(), id)
    }

    // 接口测试:init (id: String, data: Array<Int8>)
    @TestCase
    func id3v2_test_03(): Unit {
        var id: String = "id"
        var array: Array<Int8> = getArray(1)
        var frame: ID3v2Frame = ID3v2Frame(id, array)

        @Assert(frame.getData(), array)

        array = getArray(0)
        frame = ID3v2Frame(id, array)
        @Assert(frame.getData(), array)

        array = getArray(2)
        frame.setData(array)
        @Assert(frame.getData(), array)
    }

    // 接口测试:setData (data: Array<Int8>)
    @TestCase
    func id3v2_test_04(): Unit {
        var id: String = "id"
        var array: Array<Int8> = getArray(1)
        var frame: ID3v2Frame = ID3v2Frame(id, array)

        frame.setData(array)
        @Assert(frame.getData(), array)

        array = getArray(0)
        frame.setData(array)
        @Assert(frame.getData(), array)

        array = getArray(2)
        frame.setData(array)
        @Assert(frame.getData(), array)
    }

